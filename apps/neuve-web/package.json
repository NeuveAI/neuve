{
  "name": "neuve-web",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "bun run --filter web build",
    "lint": "bun run --filter web --filter '@workspace/*' lint",
    "format": "bun run --filter web --filter '@workspace/*' format",
    "typecheck": "bun run --filter web --filter '@workspace/*' typecheck",
    "storybook": "bun run --filter @workspace/ui storybook",
    "build-storybook": "bun run --filter @workspace/ui build-storybook",
    "test": "bun run --parallel --no-exit-on-error --filter web --filter '@workspace/*' test"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.2",
    "jotai": "^3.0.0"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4 <1.4.5"
  }
}
