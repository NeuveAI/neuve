{
  "name": "@neuve/graph-client",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./symbol-observation": "./src/symbol-observation.ts",
    "./git-read-session": "./src/git-read-session.ts"
  },
  "dependencies": {
    "@neuve/records-core": "workspace:*",
    "effect": "4.0.0",
    "zod": "4.6.7"
  },
  "scripts": {
    "format": "prettier --write src tests scripts package.json tsconfig.json",
    "format:check": "prettier --check src tests scripts package.json tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test --parallel --timeout=30000 ./tests",
    "verify:prepared": "bun ./scripts/verify-prepared.ts"
  }
}
