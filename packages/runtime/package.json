{
  "name": "@neuve/runtime",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./.types/src/index.d.ts",
      "default": "./src/index.ts"
    },
    "./status": {
      "types": "./.types/src/status.d.ts",
      "default": "./src/status.ts"
    },
    "./sign-in-command": {
      "types": "./.types/src/sign-in-command.d.ts",
      "default": "./src/sign-in-command.ts"
    }
  },
  "dependencies": {
    "@neuve/records-core": "workspace:*",
    "@neuve/records-schema": "workspace:*",
    "effect": "4.0.0",
    "zod": "4"
  },
  "scripts": {
    "format": "prettier --write src tests package.json tsconfig.json",
    "format:check": "prettier --check src tests package.json tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test ./tests"
  }
}
