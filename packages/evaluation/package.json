{
  "name": "@neuve/evaluation",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@effect/platform-bun": "4.0.0",
    "@neuve/graph-client": "workspace:*",
    "@neuve/harness": "workspace:*",
    "@neuve/records-core": "workspace:*",
    "effect": "4.0.0",
    "zod": "4"
  },
  "scripts": {
    "format": "prettier --write src tests scripts package.json tsconfig.json",
    "format:check": "prettier --check src tests scripts package.json tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun ../../scripts/test-budget.ts ./tests",
    "test:sensitivity": "bun ./scripts/test-sensitivity.ts",
    "probe:review-batch": "bun ./scripts/probe-review-batch-case.ts",
    "verify:graph-cache": "bun ./scripts/verify-graph-cache.ts"
  }
}
